# IncuBrix AI Background Music Engine - Environment Configuration

# Server Settings
APP_NAME=incubrix-music-engine
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
BASE_URL=http://localhost:8000

# Security & Limits
DEMO_ACCESS_TOKEN=
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_DURATION_S=300
MIN_REQUEST_DURATION_S=5
MAX_NARRATION_FILE_SIZE_MB=50
SSRF_PROTECTION_ENABLED=true

# Music Generation Provider
# Options: "mock" (default, deterministic testing without GPU/API keys), "stable_audio"
MUSIC_PROVIDER=mock

# Stable Audio 3 Configuration (Used when MUSIC_PROVIDER=stable_audio)
# Model ID: stabilityai/stable-audio-3-small-music (Requires HuggingFace gated access & Community License agreement)
STABLE_AUDIO_MODEL_ID=stabilityai/stable-audio-3-small-music
HF_TOKEN=
TORCH_DEVICE=cuda

# Stem Separator
# Options: "mock" (default, multi-part harmonic separation), "demucs" (Meta htdemucs)
STEM_SEPARATOR=mock
DEMUCS_MODEL_NAME=htdemucs
DEMUCS_DEVICE=cpu

# Audio Processing Defaults
TARGET_LUFS=-16.0
TARGET_TRUE_PEAK_DBTP=-1.0
DEFAULT_SAMPLE_RATE=48000
DURATION_TOLERANCE_S=0.05

# Storage Configuration
# Options: "local" (default filesystem), "s3" (MinIO / S3 compatible)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./storage_data
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=incubrix-audio
S3_SECURE=false

# Redis & Queue Configuration
REDIS_URL=redis://localhost:6379/0
USE_REDIS_QUEUE=false
QUEUE_CONCURRENCY=2

# Database Configuration (SQLite default for zero-dependency local dev; PostgreSQL supported)
DATABASE_URL=sqlite:///./incubrix.db

# Webhook Callback & Timeouts
WEBHOOK_SIGNING_SECRET=incubrix_webhook_secret_key
MODEL_TIMEOUT_S=45.0
